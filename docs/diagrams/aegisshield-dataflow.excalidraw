   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Data and versions: MITRE ATT&CK 20.1 (STIX 2.1)  |  MITRE ATLAS 2026.10  |  NIST CSF 2.0  |  EU AI Act (Regulation 2024/1689)  |  NeMo Guardrails 0.24.1  |  garak 0.17.1",
