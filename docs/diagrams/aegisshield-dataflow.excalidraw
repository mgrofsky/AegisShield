  },
  {
   "id": "subtitle",
   "type": "text",
   "x": 40,
   "y": 92,
   "width": 1987.1999999999998,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#334155",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 2,
   "opacity": 100,
   "groupIds": [
    "g-title"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1021,
   "version": 1,
   "versionNonce": 1028,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One shared Streamlit process drafts threat models, looks up public vulnerability data, drafts policies, analyzes packet captures, and scans a visitor's own AI workflow with garak,\nusing the model provider and credential each visitor brings. The app's model calls pass the safeguards layer unless the operator turns it off; a scan's checks are the visitor's choice.",
   "fontSize": 18,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "originalText": "One shared Streamlit process drafts threat models, looks up public vulnerability data, drafts policies, analyzes packet captures, and scans a visitor's own AI workflow with garak,\nusing the model provider and credential each visitor brings. The app's model calls pass the safeguards layer unless the operator turns it off; a scan's checks are the visitor's choice.",
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
