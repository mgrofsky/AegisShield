   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Engine behind every rail below:\nNeMo Guardrails 0.24.1\nLLMRails.check, no model judges;\nlocal pattern rules (detect.py);\nusage telemetry forced off.\nEach check: passed, modified,\nblocked, or not checked;\n'not checked' is never 'passed'.",
   "fontSize": 18,
   "fontFamily": 8,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "g-nemo",
   "originalText": "Engine behind every rail below:\nNeMo Guardrails 0.24.1\nLLMRails.check, no model judges;\nlocal pattern rules (detect.py);\nusage telemetry forced off.\nEach check: passed, modified,\nblocked, or not checked;\n'not checked' is never 'passed'.",
   "lineHeight": 1.25,
   "baseline": 16
  },
